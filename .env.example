# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL local
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/xcars
UPLOAD_STORAGE=local
# Optional isolated database for integration tests
TEST_DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/xcars_test

# Global e-mail transport (used for every agency)
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="XCars <your-email@gmail.com>"

# Optional Resend fallback when SMTP is not configured
RESEND_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional platform settings
ADMIN_EMAIL=admin@xcars.ma
TRUSTED_HOSTS=localhost:3000
